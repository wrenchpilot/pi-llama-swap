{
  "name": "@wrenchpilot/pi-llama-swap",
  "version": "0.1.4",
  "description": "Pi extension that discovers llama-swap models and registers them as a provider, with authenticated model discovery.",
  "type": "module",
  "license": "MIT",
  "author": "wrenchpilot",
  "keywords": [
    "pi-package",
    "pi-extension",
    "llama-swap",
    "llama.cpp",
    "openai-compatible",
    "api-key"
  ],
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun test && bun run typecheck",
    "prepublishOnly": "bun run check"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@types/node": "^24.0.0",
    "bun-types": "^1.3.0",
    "typescript": "^5.9.0"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "dependencies": {
    "re2js": "^2.8.6"
  }
}
